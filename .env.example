# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Transactional Email (SMTP or Provider like Resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="ACF Notifications <no-reply@acfzambia.org>"
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Form Notification Recipient Mailboxes (comma-separated ACF Microsoft 365 addresses)
CONTACT_FORM_RECIPIENTS=info@acfzambia.org
MEMBERSHIP_FORM_RECIPIENTS=membership@acfzambia.org,info@acfzambia.org

# Newsletter Integration (mock | mailchimp | brevo)
NEWSLETTER_PROVIDER=mock
NEWSLETTER_API_KEY=

# ISR / On-demand Cache Revalidation
REVALIDATE_SECRET=acf_super_secret_revalidate_token_2026

# Analytics & Monitoring (optional in dev)
NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=

# Facebook Graph API (Social Media Highlights)
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_PAGE_TOKEN=your-facebook-page-access-token
FACEBOOK_PAGE_BASE_URI=https://graph.facebook.com/v22.0
